# Daily Activity Review Bot - environment configuration
# Copy this file to .env and fill in your values.
# Bun auto-loads .env from the project root.

# REQUIRED - local Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/activity

# Required only for `bun run report` (LLM summary). Get a free key at
# https://console.groq.com . The tracker and migrate commands run without it.
GROQ_API_KEY=

# Optional - defaults shown
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Comma-separated paths to git repositories to include commit history from.
REPO_PATHS=

# Active-window poll interval (Effect duration: "5 seconds", "2000 millis").
POLL_INTERVAL=5 seconds

# Path to a zsh/bash history file to tail for shell commands. Leave empty to disable.
SHELL_HISTORY_PATH=

# Directory where YYYY-MM-DD.md report files are written.
REVIEW_DIR=~/daily-reviews

# Directory containing the <id>_<name>.sql migration files.
MIGRATIONS_DIR=migrations
