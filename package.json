{
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.103",
    "@effect/sql-pg": "4.0.0-beta.103",
    "effect": "4.0.0-beta.103"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "^1.3.14",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
